{
  "name": "earthonline-dev",
  "account_id": "2513d9129183c9319ad07b504251a69b",
  "compatibility_date": "2026-07-29",
  "main": "src/index.js",
  "assets": {
    "directory": "client/dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "dev.twonline.dpdns.org",
      "custom_domain": true
    }
  ],
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "GATEWAY", "class_name": "DiscordGateway" },
      { "name": "MARKET_WS", "class_name": "MarketWS" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DiscordGateway"] },
    { "tag": "v2", "new_sqlite_classes": ["MarketWS"] }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "earthonline-db-dev",
      "database_id": "a885dc00-5c2d-4289-91f0-9ee5411d7c63"
    }
  ],
  "triggers": {
  // ★ 2026-10-17：原本是每分鐘一次，已改成與 prod 一致的 "*/10 * * * *"。
  //
  //   原因：這個 worker 的 account_id 與 zixi-earth 相同，而 D1 免費額度是
  //   「帳號層級」—— 每分鐘排程會直接吃掉 zixi-earth 的額度。
  //   AGENTS.md 有記錄：prod 正是為此改成十分鐘一次的。
  //
  //   而且 dev.twonline.dpdns.org 已經無法解析，代表它很可能根本沒部署；
  //   狀態是「改了也不生效、但一旦有人部署就出事」。
    "crons": ["*/10 * * * *"]
  },
  "vars": {
    "DISCORD_CLIENT_ID": "1513563333985304596",
    "FRONTEND_URL": "https://dev.twonline.dpdns.org",
    "DISCORD_GUILD_ID": "1512345209005015101"
  }
}
